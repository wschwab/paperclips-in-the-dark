{
  "name": "paperclips-in-the-dark-conformance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Black-box conformance suite for the Paperclips in the Dark API",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:browser": "node scripts/browser-suite.mjs",
    "test:ada": "node scripts/default-data-guard.mjs -- node conformance/scripts/workflow-isolation-guard.mjs -- node conformance/scripts/managed-run.mjs --seed-defaults --",
    "test:tooling": "vitest run --config vitest.tooling.config.ts",
    "test:benchmark": "node scripts/dataset-benchmark.mjs",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "conformance": "bin/conformance.mjs",
    "pitd-http-stdio-shim": "bin/http-stdio-shim.mjs"
  },
  "dependencies": {
    "effect": "^3.16.12"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright-core": "^1.62.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2",
    "yaml": "^2.9.0"
  }
}
