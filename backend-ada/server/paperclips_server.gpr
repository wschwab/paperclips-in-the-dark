with "aws.gpr";
with "gnatcoll_core.gpr";
with "../core/paperclips_core.gpr";

project Paperclips_Server is
   Build_Mode := external ("GPR_BUILD", "production");
   for Source_Dirs use ("src", "src/generated");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("pitd.adb");

   package Compiler is
      --  Alire declares the production scenario, but this project owns its
      --  compiler switches. Keep runtime checks enabled in optimized builds.
      case Build_Mode is
         when "production" =>
            for Default_Switches ("Ada") use ("-gnat2022", "-O2");
         when others =>
            for Default_Switches ("Ada") use ("-gnat2022");
      end case;
   end Compiler;
end Paperclips_Server;
