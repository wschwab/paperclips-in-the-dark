    "body": "{\n  \"characters\": [\n    {\n      \"alias\": \"Luna\",\n      \"canUndo\": true,\n      \"crewId\": \"00b6a2a0-8114-4ac3-8391-1245271b5491\",\n      \"deleteToken\": \"\",\n      \"gameStem\": \"blades-in-the-dark\",\n      \"historyCount\": 17,\n      \"id\": \"7e558e39-1116-4aa3-8cbf-8b18a52b15af\",\n      \"isComplete\": true,\n      \"isDeadish\": false,\n      \"isReadable\": true,\n      \"isRepairable\": true,\n      \"isRetired\": false,\n      \"kind\": \"character\",\n      \"name\": \"Aneeya Bludsoe\",\n      \"playbook\": \"Spider\",\n      \"revision\": 24,\n      \"stress\": 0,\n      \"traumas\": [\n      ]\n    },\n    {\n      \"alias\": \"\",\n      \"canUndo\": false,\n      \"crewId\": \"\",\n      \"deleteToken\": \"\",\n      \"gameStem\": \"blades-in-the-dark\",\n      \"historyCount\": 0,\n      \"id\": \"04a433b9-89d1-4127-8689-431900291317\",\n      \"isComplete\": false,\n      \"isDeadish\": false,\n      \"isReadable\": true,\n      \"isRepairable\": true,\n      \"isRetired\": false,\n      \"kind\": \"character\",\n      \"name\": \"\",\n      \"playbook\": \"Lurk\",\n      \"revision\": 1,\n      \"stress\": 0,\n      \"traumas\": [\n      ]\n    }\n  ],\n  \"crews\": [\n    {\n      \"canUndo\": true,\n      \"crewType\": \"Smugglers\",\n      \"deleteToken\": \"\",\n      \"gameStem\": \"blades-in-the-dark\",\n      \"heat\": 0,\n      \"historyCount\": 15,\n      \"hold\": \"weak\",\n      \"id\": \"00b6a2a0-8114-4ac3-8391-1245271b5491\",\n      \"isComplete\": false,\n      \"isReadable\": true,\n      \"isRepairable\": true,\n      \"kind\": \"crew\",\n      \"memberCount\": 1,\n      \"name\": \"Gravediggers\",\n      \"rep\": 1,\n      \"revision\": 16,\n      \"tier\": 0,\n      \"wanted\": 0\n    }\n  ]\n}\n"
