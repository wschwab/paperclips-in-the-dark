{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperclips-in-the-dark/schemas/common.json",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "formatVersion": {
      "type": "integer",
      "const": 1,
      "description": "Pre-release format version 1, redefined in place (no bump). A stored document with any other value is a future/unknown format and is rejected (422 INVALID_ENTITY) until a migration pipeline exists."
    },
    "boundedInteger": {
      "type": "object",
      "required": [
        "current",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "current": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "experience": {
      "type": "object",
      "required": [
        "points",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "points": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "clockState": {
      "type": "object",
      "required": [
        "segments",
        "size"
      ],
      "additionalProperties": false,
      "properties": {
        "segments": {
          "type": "integer",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "namedDescription": {
      "type": "object",
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "harmIntensity": {
      "enum": [
        "lesser",
        "moderate",
        "severe",
        "fatal"
      ]
    },
    "closeness": {
      "enum": [
        "friend",
        "close-friend",
        "rival"
      ]
    },
    "commitment": {
      "enum": [
        "none",
        "light",
        "normal",
        "heavy",
        "encumbered"
      ]
    },
    "hold": {
      "enum": [
        "strong",
        "weak"
      ]
    },
    "cohortType": {
      "enum": [
        "gang",
        "expert"
      ]
    },
    "cohortHarm": {
      "enum": [
        "healthy",
        "weakened",
        "impaired",
        "broken",
        "dead"
      ]
    },
    "errorCode": {
      "enum": [
        "NOT_FOUND",
        "VALIDATION",
        "STALE_REVISION",
        "RETIRED",
        "CONFIRM_REQUIRED",
        "DUPLICATE",
        "SLOT_FULL_FATAL",
        "CANNOT_HEAL",
        "ARMOR_NOT_AVAILABLE",
        "ABILITY_MAXED",
        "CANNOT_LEVEL_UP",
        "RATING_MAXED",
        "UPGRADE_MAXED",
        "INSUFFICIENT_FUNDS",
        "SATCHEL_FULL",
        "OVER_BULK",
        "NO_COMMITMENT",
        "COMMITMENT_LOCKED",
        "NO_HISTORY",
        "GAME_NOT_FOUND",
        "PAYLOAD_TOO_LARGE",
        "INVALID_ENTRY",
        "INVALID_ENTITY",
        "NORMALIZATION_REQUIRED",
        "TRAUMA_REQUIRED",
        "OUT_OF_ACTION"
      ]
    },
    "errorPointer": {
      "type": "string",
      "pattern": "^(|/.*)$",
      "description": "RFC 6901 JSON pointer into the offending document; the empty string is the document root."
    },
    "errorIssue": {
      "type": "object",
      "required": [
        "pointer",
        "reason",
        "expected"
      ],
      "additionalProperties": false,
      "properties": {
        "pointer": {
          "$ref": "#/$defs/errorPointer"
        },
        "reason": {
          "type": "string",
          "description": "Why the value at the pointer is not accepted."
        },
        "expected": {
          "type": "string",
          "description": "The schema-valid value that would have been accepted."
        }
      }
    },
    "errorPointerDetails": {
      "type": "object",
      "required": [
        "issues"
      ],
      "additionalProperties": false,
      "properties": {
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/errorIssue"
          }
        }
      },
      "description": "Pointer-level detail list (VALIDATION, INVALID_ENTRY, INVALID_ENTITY): one issue per defective location, each with JSON pointer, reason, and expected value."
    },
    "errorLimitDetails": {
      "type": "object",
      "required": [
        "limit",
        "current"
      ],
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 0,
          "description": "The enforced bound the operation could not exceed."
        },
        "current": {
          "type": "integer",
          "minimum": 0,
          "description": "The value that would exceed the limit (requested amount or currently held value)."
        }
      },
      "description": "Limit details (*_MAXED, CANNOT_LEVEL_UP, CANNOT_HEAL, SATCHEL_FULL, OVER_BULK, PAYLOAD_TOO_LARGE): the enforced bound and the offending value."
    },
    "errorFundsDetails": {
      "type": "object",
      "required": [
        "available",
        "needed"
      ],
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "integer",
          "minimum": 0,
          "description": "The maximum coin amount the operation could spend (satchel coins plus stash liquidatable at the exchange rate)."
        },
        "needed": {
          "type": "integer",
          "minimum": 1,
          "description": "The coin amount the operation was asked to spend."
        }
      },
      "description": "Funds-shortage details (INSUFFICIENT_FUNDS): the coins available to spend versus the coins needed."
    },
    "errorPreviewDetails": {
      "type": "object",
      "required": [
        "warnings",
        "previewToken"
      ],
      "additionalProperties": false,
      "properties": {
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Human-readable normalization warnings (fills, conversions, clamps, listed removals)."
        },
        "previewToken": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque preview token; must be presented on the confirming apply."
        },
        "needsInputPointers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "JSON pointers that require caller-supplied values before the apply can succeed; empty when all changes are derivable."
        }
      },
      "description": "Preview details (NORMALIZATION_REQUIRED): the warnings, any needs-input pointers, and the preview token that unlocks the confirming apply."
    },
    "errorContentToken": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Opaque content token bound to the current raw bytes of a degraded entity (sha256:<lowercase hex>)."
    },
    "errorStaleDetails": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "currentRevision"
          ],
          "properties": {
            "currentRevision": {
              "$ref": "#/$defs/revision"
            },
            "currentContentToken": false
          }
        },
        {
          "required": [
            "currentContentToken"
          ],
          "properties": {
            "currentRevision": false,
            "currentContentToken": {
              "$ref": "#/$defs/errorContentToken"
            }
          }
        }
      ],
      "additionalProperties": false,
      "properties": {
        "currentRevision": {
          "$ref": "#/$defs/revision"
        },
        "currentContentToken": {
          "$ref": "#/$defs/errorContentToken"
        }
      },
      "description": "Stale details (STALE_REVISION): exactly one of currentRevision (readable entity) or currentContentToken (degraded entity whose raw bytes changed)."
    },
    "vice": {
      "type": "object",
      "required": [
        "name",
        "description",
        "purveyor"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "purveyor": {
          "$ref": "#/$defs/namedDescription"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "C4 playtest change (2026-08-09): notes are a list of free-text entries (multiple notes per sheet)."
    }
  }
}
