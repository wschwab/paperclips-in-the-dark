{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperclips-in-the-dark/schemas/crew.json",
  "title": "Crew",
  "type": "object",
  "required": [
    "kind",
    "id",
    "gameStem",
    "gameName",
    "language",
    "revision",
    "formatVersion",
    "createdAt",
    "updatedAt",
    "crewTypeName",
    "name",
    "lair",
    "reputation",
    "huntingGrounds",
    "tier",
    "hold",
    "heat",
    "wanted",
    "rep",
    "experience",
    "specialAbilities",
    "upgrades",
    "cohorts",
    "coin",
    "stash",
    "notes",
    "turf",
    "contacts",
    "factions",
    "claimedClaimIds",
    "claimOverrides"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "crew"
    },
    "id": {
      "$ref": "common.json#/$defs/uuid"
    },
    "gameStem": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+$"
    },
    "gameName": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "revision": {
      "$ref": "common.json#/$defs/revision"
    },
    "formatVersion": {
      "$ref": "common.json#/$defs/formatVersion"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "crewTypeName": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "lair": {
      "type": "string"
    },
    "reputation": {
      "type": "string"
    },
    "huntingGrounds": {
      "type": "string"
    },
    "tier": {
      "type": "integer",
      "minimum": 0
    },
    "hold": {
      "$ref": "common.json#/$defs/hold"
    },
    "heat": {
      "$ref": "common.json#/$defs/boundedInteger"
    },
    "wanted": {
      "$ref": "common.json#/$defs/boundedInteger"
    },
    "rep": {
      "$ref": "common.json#/$defs/boundedInteger"
    },
    "experience": {
      "$ref": "common.json#/$defs/experience"
    },
    "specialAbilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "timesTaken"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "timesTaken": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "upgrades": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "boxesMarked"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "boxesMarked": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "cohorts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cohortKind",
          "gangType",
          "expertType",
          "quality",
          "scale",
          "hasArmor",
          "edges",
          "flaws",
          "harm",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/uuid"
          },
          "cohortKind": {
            "$ref": "common.json#/$defs/cohortType"
          },
          "gangType": {
            "type": "string"
          },
          "expertType": {
            "type": "string"
          },
          "quality": {
            "type": "integer",
            "minimum": 0
          },
          "scale": {
            "type": "integer",
            "minimum": 0
          },
          "hasArmor": {
            "type": "boolean"
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "flaws": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "harm": {
            "$ref": "common.json#/$defs/cohortHarm"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "coin": {
      "type": "integer",
      "minimum": 0
    },
    "stash": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "$ref": "common.json#/$defs/notes"
    },
    "contacts": {
      "description": "Required canonical array (Q4); empty means no entries. C3-era crews lacking contacts normalize to [] (legacy rule L6).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "profession"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "profession": {
            "type": "string"
          }
        }
      }
    },
    "factions": {
      "description": "Required canonical array (Q4); empty means no entries. C3-era crews lacking factions normalize to [] (legacy rule L6). Status range comes from game-settings (server-clamped), never hardcoded here.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer"
          }
        }
      }
    },
    "turf": {
      "type": "integer",
      "minimum": 0,
      "description": "C4 playtest change (2026-08-09): turf held. The maximum is authoritative from game settings (TurfMax; R4 migration) — this schema deliberately declares no hardcoded upper bound. Each turf reduces the rep cost to develop by one (SRD Development)."
    },
    "claimedClaimIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true,
      "description": "Claim IDs the crew controls (from the crew type's Claims map)."
    },
    "claimOverrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claimId"
        ],
        "additionalProperties": false,
        "properties": {
          "claimId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "description": "Per-crew customizations of canonical claim fields (inherit unless overridden)."
    }
  },
  "x-requiredWhenComplete": [
    { "pointer": "/name", "predicate": "nonBlankString" },
    { "pointer": "/crewTypeName", "predicate": "nonBlankString" },
    { "pointer": "/lair", "predicate": "nonBlankString" },
    { "pointer": "/reputation", "predicate": "nonBlankString" },
    { "pointer": "/huntingGrounds", "predicate": "nonBlankString" }
  ]
}