{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperclips-in-the-dark/schemas/character.json",
  "title": "Character",
  "type": "object",
  "description": "Canonical stored character DTO, also returned byte-identically by character detail reads and raw exports. GAME-MODE-01 migration fills absent mode=free-play, modeFlow={kind:none,step:empty string}, downtime={free:the game's DowntimeSettings.FreeActivities,paid:0,spent:0,activities:[]} without rejecting legacy documents solely for these omissions; existing normalization handles partial/null import and repair. Reads never write. All mode/workflow/downtime fields are stored, revisioned and undoable; no derived assistance fields are added to character/read/roster/capability responses. suggestedOps belongs only to OperationResult.",
  "required": [
    "kind",
    "id",
    "gameStem",
    "gameName",
    "language",
    "revision",
    "formatVersion",
    "createdAt",
    "updatedAt",
    "dossier",
    "monitor",
    "talent",
    "playbook",
    "gear",
    "contacts",
    "session",
    "notebook",
    "isRetired",
    "isDeadish",
    "traumaPending",
    "isOutOfAction",
    "stressClearPending",
    "mode",
    "modeFlow",
    "downtime"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "character"
    },
    "id": {
      "$ref": "common.json#/$defs/uuid"
    },
    "gameStem": {
      "type": "string",
      "pattern": "^[A-Za-z0-9À-ɏ-]+$"
    },
    "gameName": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "revision": {
      "$ref": "common.json#/$defs/revision"
    },
    "formatVersion": {
      "$ref": "common.json#/$defs/formatVersion"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "isRetired": {
      "type": "boolean"
    },
    "isDeadish": {
      "type": "boolean",
      "description": "write-time derived from monitor.harm.fatal; never accepted as input"
    },
    "traumaPending": {
      "type": "boolean",
      "description": "true from the moment stress reaches maximum until the pending trauma is resolved"
    },
    "isOutOfAction": {
      "type": "boolean",
      "description": "true from trauma resolution until end-score; out of action for the remainder of the score"
    },
    "stressClearPending": {
      "type": "boolean",
      "description": "set and cleared together with isOutOfAction; records that end-score owes a stress clear"
    },
    "mode": {
      "$ref": "#/$defs/mode",
      "description": "Stored per-character advisory mode; default free-play. Never an operation eligibility gate."
    },
    "modeFlow": {
      "$ref": "#/$defs/modeFlow",
      "description": "Stored assistance cursor; default {kind:none,step:empty string}. Navigation never applies rewards or budget resets."
    },
    "downtime": {
      "type": "object",
      "required": ["free", "paid", "spent", "activities"],
      "additionalProperties": false,
      "description": "Stored current-budget counters. Initialize/reset free from the character game's DowntimeSettings.FreeActivities (2 in all sharing games), paid=0, spent=0, activities=[]. free is a persisted allowance snapshot, not recomputed by reads or settings changes; successful end-score or explicit downtime.reset refreshes it from then-current settings. Remaining is computed by clients as free+paid-spent, may be negative and is not a response field or hard cap. Mode/flow changes never reset counters.",
      "properties": {
        "free": { "type": "integer", "minimum": 0, "description": "Stored settings-derived free-activity allowance snapshot; no hard maximum." },
        "paid": { "type": "integer", "default": 0, "description": "Stored signed extra-activity/correction counter, changed by downtime.adjust; no automatic fund charge and no hard maximum." },
        "spent": { "type": "integer", "minimum": 0, "default": 0 },
        "activities": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": ["activity", "description"],
            "additionalProperties": false,
            "properties": {
              "activity": { "$ref": "#/$defs/downtimeActivity" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "dossier": {
      "type": "object",
      "required": [
        "name",
        "crewId",
        "alias",
        "look",
        "notes",
        "background",
        "heritage",
        "vice"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "crewId": {
          "type": "string",
          "description": "UUID of linked crew, or empty string",
          "pattern": "^([0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})?$"
        },
        "alias": {
          "type": "string"
        },
        "look": {
          "type": "string"
        },
        "notes": {
          "$ref": "common.json#/$defs/notes"
        },
        "background": {
          "$ref": "common.json#/$defs/namedDescription"
        },
        "heritage": {
          "$ref": "common.json#/$defs/namedDescription"
        },
        "vice": {
          "$ref": "common.json#/$defs/vice"
        }
      }
    },
    "monitor": {
      "type": "object",
      "required": [
        "stress",
        "trauma",
        "harm",
        "armor"
      ],
      "additionalProperties": false,
      "properties": {
        "stress": {
          "$ref": "common.json#/$defs/boundedInteger"
        },
        "trauma": {
          "type": "object",
          "required": [
            "traumas",
            "max"
          ],
          "additionalProperties": false,
          "properties": {
            "traumas": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "harm": {
          "type": "object",
          "required": [
            "lesser",
            "moderate",
            "severe",
            "fatal",
            "healingClock"
          ],
          "additionalProperties": false,
          "properties": {
            "lesser": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "moderate": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "severe": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fatal": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "healingClock": {
              "type": "object",
              "required": [
                "segments",
                "size",
                "rollover"
              ],
              "additionalProperties": false,
              "properties": {
                "segments": {
                  "type": "integer",
                  "minimum": 0
                },
                "size": {
                  "type": "integer",
                  "minimum": 1
                },
                "rollover": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "armor": {
          "type": "object",
          "required": [
            "standardUsed",
            "heavyUsed",
            "specialUsed",
            "hasStandard",
            "hasHeavy",
            "hasSpecial"
          ],
          "additionalProperties": false,
          "properties": {
            "standardUsed": {
              "type": "boolean"
            },
            "heavyUsed": {
              "type": "boolean"
            },
            "specialUsed": {
              "type": "boolean"
            },
            "hasStandard": {
              "type": "boolean",
              "description": "derived from loadout"
            },
            "hasHeavy": {
              "type": "boolean",
              "description": "derived from loadout"
            },
            "hasSpecial": {
              "type": "boolean",
              "description": "derived from ability descriptions"
            }
          }
        }
      }
    },
    "talent": {
      "type": "object",
      "required": [
        "attributes"
      ],
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "experience",
              "actions"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "experience": {
                "$ref": "common.json#/$defs/experience"
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "rating",
                    "maxRating"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "rating": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "maxRating": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "playbook": {
      "type": "object",
      "required": [
        "name",
        "experience",
        "abilities"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "experience": {
          "$ref": "common.json#/$defs/experience"
        },
        "abilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "description",
              "timesTaken"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "timesTaken": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "gear": {
      "type": "object",
      "required": [
        "loadout",
        "availableGear",
        "commitment",
        "isCommitmentLocked",
        "maxBulk"
      ],
      "additionalProperties": false,
      "properties": {
        "loadout": {
          "$ref": "#/$defs/gearItems"
        },
        "availableGear": {
          "$ref": "#/$defs/gearItems"
        },
        "commitment": {
          "$ref": "common.json#/$defs/commitment"
        },
        "isCommitmentLocked": {
          "type": "boolean"
        },
        "maxBulk": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fund": {
      "type": "object",
      "required": [
        "satchel",
        "stash"
      ],
      "additionalProperties": false,
      "properties": {
        "satchel": {
          "type": "object",
          "required": [
            "coins",
            "max"
          ],
          "additionalProperties": false,
          "properties": {
            "coins": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "stash": {
          "type": "object",
          "required": [
            "coins",
            "max"
          ],
          "additionalProperties": false,
          "properties": {
            "coins": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "contacts": {
      "description": "CONTRACT-05 (2026-08-25 correction of the 2026-08-24 card): the per-scoundrel relationship list, EVOLVED from the former BitS rolodex surface by human ruling ('instead of calling it Rolodex, let's just call it Contacts') — exactly one family. Required canonical array. A new scoundrel is created with its playbook's Rolodex friends (game-settings Playbooks[].Rolodex.Friends) at closeness contact (CONTRACT-CONTACTS-01, human-authorized 2026-10-08); the list is empty only when the playbook has no Rolodex friends. Closeness vocabulary is exactly enemy | rival | contact | friend | confidante (CONTRACT-CONTACTS-01, 2026-10-08 ruling; ordered enemy < rival < contact < friend < confidante). Legacy close-friend values are NOT auto-migrated (update stored documents; see docs/pages/contract/contract-c5-character-contacts.mdx).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "closeness"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "closeness": {
            "$ref": "common.json#/$defs/closeness"
          }
        }
      }
    },
    "session": {
      "type": "object",
      "required": [
        "playbookExpressions",
        "characterExpressions",
        "struggleExpressions",
        "max",
        "desperateMarks"
      ],
      "additionalProperties": false,
      "properties": {
        "playbookExpressions": {
          "type": "integer",
          "minimum": 0
        },
        "characterExpressions": {
          "type": "integer",
          "minimum": 0
        },
        "struggleExpressions": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "desperateMarks": {
          "type": "array",
          "description": "Desperate-action XP marks this Score, one attribute name per +1 mark (DESPERATE-LOG-01). Cleared when the mode changes into Score; not cleared by xp.resolve.",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "notebook": {
      "type": "string"
    }
  },
  "x-requiredWhenComplete": [
    { "pointer": "/dossier/name", "predicate": "nonBlankString" },
    { "pointer": "/dossier/alias", "predicate": "nonBlankString" },
    { "pointer": "/dossier/look", "predicate": "nonBlankString" },
    { "pointer": "/dossier/heritage/name", "predicate": "nonBlankString" },
    { "pointer": "/dossier/background/name", "predicate": "nonBlankString" },
    { "pointer": "/dossier/vice/name", "predicate": "nonBlankString" },
    { "pointer": "/dossier/vice/purveyor/name", "predicate": "nonBlankString" },
    { "pointer": "/playbook/name", "predicate": "nonBlankString" }
  ],
  "$defs": {
    "mode": {
      "type": "string",
      "enum": ["free-play", "score", "downtime"],
      "default": "free-play"
    },
    "modeFlow": {
      "type": "object",
      "required": ["kind", "step"],
      "additionalProperties": false,
      "description": "Semantic kind/step pairing is mandatory: none requires empty step; score-start permits only planning, loadout, engagement; resolution permits only scoundrel-xp, payoff, heat, entanglements, crew-xp, crew-rep. Invalid pairs are VALIDATION, not mode errors. These constraints apply to stored canonical data and requests. No sequencing or completion prerequisite.",
      "properties": {
        "kind": { "type": "string", "enum": ["none", "score-start", "resolution"], "default": "none" },
        "step": { "type": "string", "enum": ["", "planning", "loadout", "engagement", "scoundrel-xp", "payoff", "heat", "entanglements", "crew-xp", "crew-rep"], "default": "" }
      }
    },
    "downtimeActivity": {
      "type": "string",
      "enum": ["acquire-asset", "long-term-project", "recover", "reduce-heat", "train", "indulge-vice", "other"]
    },
    "gearItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "bulk"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "bulk": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
